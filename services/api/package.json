{
  "name": "@lwa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "admin:create-tenant": "tsx --env-file-if-exists=../../.env src/admin/create-tenant.ts",
    "admin:set-password": "tsx --env-file-if-exists=../../.env src/admin/set-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-openapi": "^0.16.0",
    "@hono/zod-validator": "^0.4.3",
    "@lwa/auth": "workspace:*",
    "@lwa/connectors": "workspace:*",
    "@lwa/contracts": "workspace:*",
    "@lwa/crypto": "workspace:*",
    "@lwa/db": "workspace:*",
    "better-auth": "^1.0.0",
    "bullmq": "^5.13.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^8.0.5",
    "pino": "^9.4.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@lwa/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.0",
    "vitest": "^1.6.0"
  }
}
