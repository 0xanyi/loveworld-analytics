# Core
NODE_ENV=development
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgres://lwa:lwa_dev@localhost:5432/lwa_dev

# Redis
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────
# SECURITY: All values below prefixed "change_me_" are placeholders.
# Boot-time validators (added in Task 4: packages/auth and Task 6:
# services/api) MUST reject any secret starting with "change_me_" so
# a forgotten copy-paste fails loudly instead of silently using a
# deterministic, git-tracked value.
# ─────────────────────────────────────────────────────────────────────

# Web app
VITE_API_BASE_URL=http://localhost:3001

# Better Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change_me_to_random_32_chars_min
AUTH_BASE_URL=http://localhost:3001

# API
API_PORT=3001
API_BASE_URL=http://localhost:3001
# CORS allowlist — comma-separated origins (dev: SvelteKit's default port)
ALLOWED_ORIGINS=http://localhost:5173

# Ingestion worker
INGESTION_CONCURRENCY=4

# KEK for connector credential encryption (32 bytes, base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LWA_KEK_CURRENT=v1
LWA_KEK_V1=change_me_generate_random_32_bytes_base64

# Email (magic links + alerts) — fill when configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
